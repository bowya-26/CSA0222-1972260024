#include <stdio.h>

#define FIXED_CHARGE 5000L
#define RATE1 0
#define RATE2 225
#define RATE3 450

long compute_bill(int units)
{
    long bill = FIXED_CHARGE;

    if (units <= 100)
        bill += units * RATE1;

    else if (units <= 200)
        bill += (units - 100) * RATE2;

    else
    {
        bill += 100 * RATE2;
        bill += (units - 200) * RATE3;
    }

    return bill;
}

int main()
{
    int units;
    long bill;

    printf("Enter units consumed: ");
    scanf("%d", &units);

    if (units < 0)
    {
        printf("Invalid units\n");
        return 0;
    }

    bill = compute_bill(units);

    printf("Units consumed: %d\n", units);
    printf("Total Bill: Rs %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}
