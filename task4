#include <stdio.h>

#define SQUARE(x) ((x) * (x))
#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define RUPEES_TO_PAISE(x) ((x) * 100)

int main()
{
    int a = 5;
    int b = 10;

    printf("Square of %d = %d\n", a, SQUARE(a));

    printf("Maximum of %d and %d = %d\n", a, b, MAX(a, b));

    printf("5 rupees in paise = %d\n", RUPEES_TO_PAISE(5));

    return 0;
}
